{
  "name": "@ecommerce/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:all": "nx run-many -t build --all --output-style=static",
    "serve:all": "nx run-many -t serve --projects api,@ecommerce/payment --parallel=2 --output-style=stream --verbose",
    "migration:run": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/api/src/data-source.ts",
    "migration:revert": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/api/src/data-source.ts",
    "migration:generate": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:generate -d apps/api/src/data-source.ts",
    "migration:show": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:show -d apps/api/src/data-source.ts",
    "payment:migration:run": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/payment/src/data-source.ts",
    "payment:migration:revert": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/payment/src/data-source.ts",
    "payment:migration:show": "node --require @swc-node/register --require tsconfig-paths/register node_modules/typeorm/cli.js migration:show -d apps/payment/src/data-source.ts",
    "dev:all": "concurrently -k -n api,payment,web -c blue,magenta,green \"nx serve api\" \"nx serve @ecommerce/payment\" \"nx dev @ecommerce/web --port 3100\""
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "^21.2.11",
    "@angular-devkit/schematics": "^21.2.11",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "22.7.2",
    "@nx/eslint": "22.7.2",
    "@nx/eslint-plugin": "22.7.2",
    "@nx/js": "^22.7.2",
    "@nx/nest": "^22.7.2",
    "@nx/next": "^22.7.2",
    "@nx/node": "22.7.2",
    "@nx/playwright": "22.7.2",
    "@nx/vitest": "22.7.2",
    "@nx/web": "22.7.2",
    "@nx/webpack": "22.7.2",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "^21.2.11",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/register": "^0.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.2",
    "prettier": "~3.6.2",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.21",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.14",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
