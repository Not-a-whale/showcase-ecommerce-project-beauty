    "next": "~16.1.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "stripe": "^22.6.2",
    "swagger-ui-express": "^5.0.1",
    "swiper": "^14.3.0",
    "typeorm": "^0.3.29",
    "zustand": "^5.0.15"
  }
}
